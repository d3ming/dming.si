{
  "name": "dming-si",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "content": "node scripts/content.mjs",
    "public-check": "node scripts/check-public.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "build": "astro build && node scripts/verify-build.mjs",
    "test": "npm run build && playwright test",
    "check": "npm run public-check && npm run lint && npm run typecheck && npm test",
    "publish:site": "node scripts/publish.mjs"
  },
  "dependencies": {
    "astro": "7.4.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3"
  }
}
